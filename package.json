{
  "name": "cognito-local",
  "version": "0.0.0-development",
  "license": "MIT",
  "bin": "lib/bin/start.js",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc --emitDeclarationOnly --project tsconfig.build.json && esbuild $(find src -name '*.ts' ! -name '*.test.ts' ! -path '*/__tests__/*') --outdir=lib --platform=node --target=node24 --format=cjs && cp -r src/keys lib/keys",
    "lint": "biome check --write",
    "start": "COGNITO_LOCAL_DEVMODE=1 tsx src/bin/start.ts",
    "start:debug": "COGNITO_LOCAL_DEVMODE=1 DEBUG=1 tsx --inspect-brk src/bin/start.ts",
    "start:watch": "nodemon",
    "test": "vitest",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/aws-lambda": "^8.10.163",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.mergewith": "^4.6.9",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdown-toc": "^1.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@aws-crypto/client-node": "^3.2.2",
    "aws-sdk": "^2.1693.0",
    "body-parser": "^2.3.0",
    "boxen": "^9.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lodash.mergewith": "^4.6.2",
    "nodemailer": "^10.0.11",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "short-uuid": "^6.0.3",
    "stormdb": "^0.6.0",
    "uuid": "^14.0.2"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "npm start"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/HRlogics/cognito-local.git"
  }
}
